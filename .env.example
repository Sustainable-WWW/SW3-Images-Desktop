# Copy this file to `.env` in the project root and fill in your values.
# The server loads it automatically at startup. Never commit the real .env.

# Brevo (https://app.brevo.com → SMTP & API → API Keys) — used to email you
# whenever someone unlocks the 50-file limit with their name and email.
BREVO_API_KEY=xkeysib-your-key-here

# Where the "new lead" notification is sent.
LEAD_NOTIFY_EMAIL=info@sustainablewww.org

# Optional: the sender address (must be a verified sender in Brevo).
# Defaults to LEAD_NOTIFY_EMAIL if not set.
LEAD_FROM_EMAIL=info@sustainablewww.org

# Optional overrides:
# PORT=2500
# SW3_DATA=./data
# TRUST_PROXY=1
